DISCORD_TOKEN=
DB_PATH=/data/ffeventnotify.sqlite
FIXTURE_DUMP_DIR=./data/fixtures
# LOG_LEVEL=info   # info (Standard) oder debug (jede Anfrage, Stacks)

# Web-Checkliste
# Öffentliche Adresse der Seite, ohne Schrägstrich am Ende. Steht in den Links, die der Bot verschickt.
WEB_BASE_URL=https://ffevents.esembe.app
# Domain für den Caddy-Proxy (nur compose.prod.yaml); Zertifikat: Cloudflare Origin Certificate in certs/.
WEB_DOMAIN=ffevents.esembe.app
# Port des Webservers im Container (Standard 3480).
# WEB_PORT=3480
# 32 Zufallsbytes, base64. Verschlüsselt die persönlichen Links. Erzeugen mit: openssl rand -base64 32  (oder: pnpm gen-secret)
# Wer den Wert ändert, macht alle bisherigen Links ungültig.
WEB_LINK_SECRET=
